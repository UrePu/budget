# Supabase 프로젝트 설정 → API 에서 확인
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 세션 서명 + 비밀번호 해시 pepper 용 랜덤 문자열 (예: openssl rand -hex 32)
# 배포 후 바꾸면 모든 세션이 무효화되고 기존 계정 비밀번호 조회가 불가능해지므로 유지할 것
AUTH_SECRET=change-me-to-a-long-random-string

# 새 가계부(계정) 생성에 필요한 가입 코드 — 코드를 아는 사람만 계정을 만들 수 있음
# 비워두거나 지우면 신규 가입이 완전히 차단됨 (기존 계정 로그인은 계속 가능)
REGISTER_CODE=change-me

